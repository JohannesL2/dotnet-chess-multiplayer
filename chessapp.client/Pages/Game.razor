@page "/game"
@using Microsoft.AspNetCore.SignalR.Client
@using ChessDotNet
@inject NavigationManager Navigation
@implements IAsyncDisposable

<h3>Multiplayer Chess</h3>

@if (hubConnection?.State == HubConnectionState.Connected)
{
    <p style="color: green;">Connected to the server!</p>
    
    <ChessBoard Fen="@currentFen" OnMoveMade="HandleMoveMade" />

    <p>Latest move/notation: <code>@lastMove</code></p>
    @if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color: red; font-weight: bold;">@errorMessage</p>
}
}
else
{
    <p>Connecting to the chess server...</p>
}

@code {
    private HubConnection? hubConnection;
    private ChessGame chessGame = new ChessGame();
    private string errorMessage = string.Empty;
    private string currentFen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    private string lastMove = "";
    
    protected override async Task OnInitializedAsync()
{
    chessGame = new ChessGame();
    currentFen = chessGame.GetFen();

    hubConnection = new HubConnectionBuilder()
        .WithUrl("http://localhost:5180/chessHub")
        .WithAutomaticReconnect()
        .Build();

    hubConnection.On<string>("ReceiveMove", (newFen) =>
    {
        currentFen = newFen;
        
        chessGame = new ChessGame(newFen);
        errorMessage = "";
        
        StateHasChanged();
    });

    await hubConnection.StartAsync();
    await hubConnection.SendAsync("JoinGame", "room-123");
}

private async Task HandleMoveMade(string moveNotation)
{
    lastMove = moveNotation;

    var parts = moveNotation.Split('-');
    if (parts.Length != 2) return;

    try
    {
        var move = new Move(parts[0].ToUpper(), parts[1].ToUpper(), chessGame.WhoseTurn);

        if (chessGame.IsValidMove(move))
        {
            chessGame.MakeMove(move, true);
            currentFen = chessGame.GetFen();
            errorMessage = "";

            if (hubConnection is not null)
            {
                await hubConnection.SendAsync("SendMove", "room-123", currentFen);
            }
        }
        else
        {
            errorMessage = "Invalid move!";
        }
    }
    catch (Exception ex)
    {
        errorMessage = $"Error processing move: {ex.Message}";
    }
}

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
